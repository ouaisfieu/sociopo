{
  "name": "sociopo",
  "version": "1.0.0",
  "private": true,
  "description": "Sociopo — encyclopédie interactive de la sociopolitique belge (site statique JAMstack).",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('_site',{recursive:true,force:true})\"",
    "build:site": "eleventy",
    "build:search": "pagefind --site _site",
    "build": "npm run clean && npm run build:site && npm run build:search",
    "dev": "eleventy --serve --quiet",
    "start": "npm run dev",
    "check": "node scripts/check.mjs",
    "test": "npm run build && npm run check",
    "split": "node scripts/split-bundles.mjs",
    "images": "node scripts/make-images.mjs"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "d3-force": "^3.0.0",
    "esbuild": "^0.28.2",
    "gray-matter": "^4.0.3",
    "markdown-it": "^14.3.2",
    "pagefind": "^1.5.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ouaisfieu/sociopo.git"
  },
  "homepage": "https://ouaisfieu.github.io/sociopo/"
}
