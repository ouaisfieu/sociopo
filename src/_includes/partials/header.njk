{%- set navItems = [
  { url: "/lexique/", label: "Lexique" },
  { url: "/themes/", label: "Thèmes" },
  { url: "/partis/", label: "Partis" },
  { url: "/personnalites/", label: "Personnalités" },
  { url: "/gouvernements/", label: "Gouvernements" },
  { url: "/elections/", label: "Élections" },
  { url: "/chronologie/", label: "Chronologie" },
  { url: "/dossiers/", label: "Dossiers" },
  { url: "/jouer/", label: "Jouer" }
] -%}
<header class="site-header">
  <div class="container bar">
    <a class="brand" href="/" aria-label="Sociopo — accueil">
      <svg aria-hidden="true" style="color:var(--brick)"><use href="#i-logo"></use></svg>
      <span>Sociopo<small>sociopolitique belge</small></span>
    </a>
    <nav class="main-nav" id="main-nav" aria-label="Navigation principale">
      <ul>
        {%- for item in navItems %}
        <li><a href="{{ item.url }}"{% if page.url.startsWith(item.url) %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
        {%- endfor %}
      </ul>
    </nav>
    <div class="header-tools">
      <button class="icon-btn search-trigger" type="button" data-search-open aria-label="Rechercher (raccourci : /)">
        {% icon "search" %}<span class="label">Rechercher…</span><kbd>/</kbd>
      </button>
      <a class="icon-btn" href="/parcours/" title="Mon parcours (progression, badges)" aria-label="Mon parcours">{% icon "trophy" %}<span class="progress-pill" data-progress-pill hidden></span></a>
      <button class="icon-btn" type="button" data-theme-toggle aria-label="Changer de thème (clair, sombre, système)" title="Thème">{% icon "contrast" %}</button>
      <button class="icon-btn menu-toggle" type="button" aria-controls="main-nav" aria-expanded="false" data-menu-toggle aria-label="Ouvrir le menu">{% icon "menu" %}</button>
    </div>
  </div>
</header>
